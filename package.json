{
  "name": "bluefox-browser",
  "private": true,
  "version": "2.0.70",
  "author": "BlueFox Team",
  "description": "Navigateur BlueFox - Rapide, Stable, Gaming",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"cross-env BROWSER=none npm run react-start\" \"electron .\"",
    "react-start": "npx vite",
    "build": "npx vite build",
    "dist": "npm run build && electron-builder",
    "build:inno": "npm run build && electron-builder --dir && npm run inno",
    "inno": "C:\\Users\\ADMINI~1\\AppData\\Local\\Programs\\INNOSE~1\\ISCC.exe build\\setup.iss",
    "lint": "npx eslint .",
    "preview": "npx vite preview"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "react-i18next": "^17.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@huggingface/transformers": "^4.2.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^43.4.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.21.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fetch-jsonp": "^1.4.0",
    "globals": "^15.15.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "postcss": "^8.5.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.0"
  },
  "build": {
    "publish": [
      {
        "provider": "github",
        "owner": "Clipdescript",
        "repo": "BlueFox"
      }
    ],
    "appId": "com.bluefox.browser",
    "productName": "BlueFox Browser",
    "files": [
      "dist-react/**/*",
      "public/**/*",
      "main.js",
      "preload.js",
      ".env",
      "package.json",
      "splash.html"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release-254"
    },
    "artifactName": "BlueFox-Browser-Setup-${version}.${ext}",
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF document",
        "description": "Ouvrir un PDF dans BlueFox",
        "mimeType": "application/pdf",
        "role": "Viewer",
        "icon": "public/Logo.ico"
      }
    ],
    "protocols": [
      {
        "name": "HTTP URL",
        "schemes": [
          "http"
        ],
        "role": "Viewer"
      },
      {
        "name": "HTTPS URL",
        "schemes": [
          "https"
        ],
        "role": "Viewer"
      },
      {
        "name": "FTP URL",
        "schemes": [
          "ftp"
        ],
        "role": "Viewer"
      },
      {
        "name": "BlueFox Protocol",
        "schemes": [
          "bluefox"
        ],
        "role": "Viewer"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/Logo.ico"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BlueFox Browser",
      "installerIcon": "public/Logo.ico",
      "uninstallerIcon": "public/Logo.ico",
      "installerHeaderIcon": "public/Logo.ico",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": false,
      "perMachine": false,
      "allowElevation": true
    }
  }
}
